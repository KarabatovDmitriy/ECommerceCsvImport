@model ECommerceCsvImport.Models.ProductsIndexViewModel
@{ ViewData["Title"] = "Список товаров"; }

<h1>Товары</h1>
<p>Всего товаров: @Model.TotalCount</p>
<p>Общая стоимость: @Model.TotalValue.ToString("N0") RUB</p>

@if (Model.Products.Count == 0)
{
    <div class="alert alert-info">Товары еще не импортированы.</div>
}
else
{
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>Артикул</th><th>Название</th><th>Описание</th><th>Цена</th>
                <th>Валюта</th><th>Категория</th><th>Остаток</th><th>Активен</th>
                <th>Бренд</th><th>Гарантия, мес.</th><th>Модель</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td>@p.Sku</td><td>@p.Name</td><td>@p.Description</td>
                <td>@p.Price.ToString("N0")</td><td>@p.Currency</td>
                <td>@p.CategoryName</td><td>@p.StockQuantity</td>
                <td>@(p.IsActive ? "Да" : "Нет")</td><td>@p.Brand</td>
                <td>@p.WarrantyMonths</td><td>@p.ModelNumber</td>
            </tr>
        }
        </tbody>
    </table>
}
<a asp-action="Import" class="btn btn-primary mt-3">Импортировать товары</a>